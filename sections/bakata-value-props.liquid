{% comment %}
  Bakatá value proposition strip.
  Keeps the homepage useful before the product catalog is finalized.
{% endcomment %}

<section
  class="bakata-value-props"
  style="
    --bakata-value-bg: {{ section.settings.background_color }};
    --bakata-value-text: {{ section.settings.text_color }};
    --bakata-value-accent: {{ section.settings.accent_color }};
  "
>
  <div class="bakata-value-props__inner page-width">
    <div class="bakata-value-props__intro">
      {% if section.settings.eyebrow != blank %}
        <p class="bakata-value-props__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2 class="bakata-value-props__heading">{{ section.settings.heading | escape }}</h2>
      {% endif %}
      {% if section.settings.description != blank %}
        <p class="bakata-value-props__description">{{ section.settings.description | escape }}</p>
      {% endif %}
    </div>

    <div class="bakata-value-props__grid">
      {% for index in (1..3) %}
        {% liquid
          assign title_key = 'item_' | append: index | append: '_title'
          assign text_key = 'item_' | append: index | append: '_text'
          assign item_title = section.settings[title_key]
          assign item_text = section.settings[text_key]
        %}
        {% if item_title != blank or item_text != blank %}
          <article class="bakata-value-props__card">
            <span class="bakata-value-props__number" aria-hidden="true">0{{ index }}</span>
            {% if item_title != blank %}
              <h3 class="bakata-value-props__card-title">{{ item_title | escape }}</h3>
            {% endif %}
            {% if item_text != blank %}
              <p class="bakata-value-props__card-text">{{ item_text | escape }}</p>
            {% endif %}
          </article>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

{% stylesheet %}
  .bakata-value-props {
    background: var(--bakata-value-bg);
    color: var(--bakata-value-text);
  }

  .bakata-value-props__inner {
    display: grid;
    gap: 32px;
    padding-block: 56px;
  }

  .bakata-value-props__intro {
    max-width: 720px;
  }

  .bakata-value-props__eyebrow {
    margin: 0 0 10px;
    color: var(--bakata-value-accent);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .bakata-value-props__heading {
    margin: 0;
    max-width: 14ch;
    font: inherit;
    font-family: var(--font-heading--family);
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: var(--font-heading--weight);
    line-height: 0.98;
    text-wrap: balance;
  }

  .bakata-value-props__description {
    margin: 18px 0 0;
    max-width: 58ch;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-70));
    font-size: 1rem;
    line-height: 1.6;
  }

  .bakata-value-props__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 12px;
  }

  .bakata-value-props__card {
    min-width: 0;
    padding: 22px;
    border: 1px solid color-mix(in srgb, var(--bakata-value-text) 12%, transparent);
    border-radius: 18px;
    background: color-mix(in srgb, var(--bakata-value-bg) 72%, white);
  }

  .bakata-value-props__number {
    display: inline-flex;
    margin-bottom: 28px;
    color: var(--bakata-value-accent);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .bakata-value-props__card-title {
    margin: 0;
    font-size: 1.15rem;
    line-height: 1.2;
  }

  .bakata-value-props__card-text {
    margin: 8px 0 0;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-70));
    line-height: 1.55;
  }

  @media screen and (min-width: 750px) {
    .bakata-value-props__inner {
      gap: 44px;
      padding-block: 72px;
    }

    .bakata-value-props__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 16px;
    }

    .bakata-value-props__card {
      padding: 28px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Bakatá - Confianza",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Etiqueta",
      "default": "Hecho para comprar sin vueltas"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Menos ruido. Más cosas útiles."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Descripción",
      "default": "Bakatá selecciona productos prácticos y construye una experiencia de compra clara para Colombia."
    },
    {
      "type": "text",
      "id": "item_1_title",
      "label": "Beneficio 1 - título",
      "default": "Selección útil"
    },
    {
      "type": "textarea",
      "id": "item_1_text",
      "label": "Beneficio 1 - texto",
      "default": "Priorizamos productos que resuelven algo real y se entienden rápido."
    },
    {
      "type": "text",
      "id": "item_2_title",
      "label": "Beneficio 2 - título",
      "default": "Compra clara"
    },
    {
      "type": "textarea",
      "id": "item_2_text",
      "label": "Beneficio 2 - texto",
      "default": "Información simple, precios visibles y una navegación sin fricción."
    },
    {
      "type": "text",
      "id": "item_3_title",
      "label": "Beneficio 3 - título",
      "default": "Soporte cercano"
    },
    {
      "type": "textarea",
      "id": "item_3_text",
      "label": "Beneficio 3 - texto",
      "default": "Si tienes una duda antes o después de comprar, queremos que sea fácil resolverla."
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Fondo",
      "default": "#F3E9DC"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Texto",
      "default": "#17352B"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Acento",
      "default": "#A55334"
    }
  ],
  "presets": [
    {
      "name": "Bakatá - Confianza"
    }
  ]
}
{% endschema %}
