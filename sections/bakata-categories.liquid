{% comment %}
  Bakatá category teaser. Links can be updated when real collections are ready.
{% endcomment %}

<section class="bakata-categories" style="--bc-bg: {{ section.settings.background_color }}; --bc-text: {{ section.settings.text_color }}; --bc-accent: {{ section.settings.accent_color }};">
  <div class="page-width bakata-categories__inner">
    <div class="bakata-categories__header">
      <div>
        {% if section.settings.eyebrow != blank %}
          <p class="bakata-categories__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {% endif %}
        {% if section.settings.heading != blank %}
          <h2>{{ section.settings.heading | escape }}</h2>
        {% endif %}
      </div>
      {% if section.settings.description != blank %}
        <p>{{ section.settings.description | escape }}</p>
      {% endif %}
    </div>

    <div class="bakata-categories__grid">
      {% for index in (1..3) %}
        {% liquid
          assign title_key = 'card_' | append: index | append: '_title'
          assign text_key = 'card_' | append: index | append: '_text'
          assign link_key = 'card_' | append: index | append: '_link'
          assign title = section.settings[title_key]
          assign text = section.settings[text_key]
          assign link = section.settings[link_key]
        %}
        <a class="bakata-categories__card bakata-categories__card--{{ index }}" href="{{ link | default: routes.all_products_collection_url }}">
          <span class="bakata-categories__index">0{{ index }}</span>
          <div>
            <h3>{{ title | escape }}</h3>
            <p>{{ text | escape }}</p>
          </div>
          <span class="bakata-categories__arrow" aria-hidden="true">↗</span>
        </a>
      {% endfor %}
    </div>
  </div>
</section>

{% stylesheet %}
  .bakata-categories {
    background: var(--bc-bg);
    color: var(--bc-text);
  }

  .bakata-categories__inner {
    padding-block: clamp(64px, 8vw, 100px);
  }

  .bakata-categories__header {
    display: grid;
    grid-template-columns: 1fr minmax(260px, 0.62fr);
    gap: 32px;
    align-items: end;
    margin-bottom: 36px;
  }

  .bakata-categories__eyebrow {
    margin: 0 0 10px;
    color: var(--bc-accent);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .bakata-categories__header h2 {
    margin: 0;
    max-width: 12ch;
    font-family: var(--font-heading--family);
    font-size: clamp(2.35rem, 5vw, 4.4rem);
    line-height: 0.96;
    letter-spacing: -0.045em;
    text-wrap: balance;
  }

  .bakata-categories__header > p {
    margin: 0;
    color: color-mix(in srgb, var(--bc-text) 66%, transparent);
    line-height: 1.65;
  }

  .bakata-categories__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
  }

  .bakata-categories__card {
    position: relative;
    min-height: 300px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 24px;
    overflow: hidden;
    border-radius: 24px;
    border: 1px solid color-mix(in srgb, var(--bc-text) 10%, transparent);
    color: var(--bc-text);
    text-decoration: none;
    transition: transform 180ms ease, box-shadow 180ms ease;
  }

  .bakata-categories__card:hover {
    transform: translateY(-4px);
    box-shadow: 0 18px 45px rgb(23 53 43 / 0.10);
  }

  .bakata-categories__card--1 { background: #F3E9DC; }
  .bakata-categories__card--2 { background: #E7B85A; }
  .bakata-categories__card--3 { background: #A55334; color: #FFF9F1; }

  .bakata-categories__index {
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    opacity: 0.72;
  }

  .bakata-categories__card h3 {
    max-width: 8ch;
    margin: 0;
    font-size: clamp(1.8rem, 3vw, 2.8rem);
    line-height: 0.98;
    letter-spacing: -0.04em;
  }

  .bakata-categories__card p {
    max-width: 29ch;
    margin: 12px 0 0;
    opacity: 0.72;
    line-height: 1.5;
  }

  .bakata-categories__arrow {
    position: absolute;
    top: 22px;
    right: 22px;
    font-size: 1.25rem;
  }

  @media screen and (max-width: 749px) {
    .bakata-categories__header {
      grid-template-columns: 1fr;
      gap: 18px;
    }

    .bakata-categories__grid {
      grid-template-columns: 1fr;
    }

    .bakata-categories__card {
      min-height: 230px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Bakatá - Categorías",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Etiqueta",
      "default": "Lo que vas a encontrar"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Cosas que merecen un lugar en tu día."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Descripción",
      "default": "Estamos construyendo una selección pequeña y útil. Menos catálogo infinito, más productos con una razón para estar aquí."
    },
    {
      "type": "text",
      "id": "card_1_title",
      "label": "Tarjeta 1 - título",
      "default": "Hogar que ayuda"
    },
    {
      "type": "textarea",
      "id": "card_1_text",
      "label": "Tarjeta 1 - texto",
      "default": "Pequeñas soluciones para ordenar, limpiar y hacer más llevadero lo cotidiano."
    },
    {
      "type": "url",
      "id": "card_1_link",
      "label": "Tarjeta 1 - enlace"
    },
    {
      "type": "text",
      "id": "card_2_title",
      "label": "Tarjeta 2 - título",
      "default": "Cuidado sin complicarte"
    },
    {
      "type": "textarea",
      "id": "card_2_text",
      "label": "Tarjeta 2 - texto",
      "default": "Productos pensados para simplificar tu rutina, no para llenarla de pasos."
    },
    {
      "type": "url",
      "id": "card_2_link",
      "label": "Tarjeta 2 - enlace"
    },
    {
      "type": "text",
      "id": "card_3_title",
      "label": "Tarjeta 3 - título",
      "default": "Gadgets con propósito"
    },
    {
      "type": "textarea",
      "id": "card_3_text",
      "label": "Tarjeta 3 - texto",
      "default": "Tecnología sencilla para resolver cosas concretas, sin pagar por funciones que no necesitas."
    },
    {
      "type": "url",
      "id": "card_3_link",
      "label": "Tarjeta 3 - enlace"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Fondo",
      "default": "#FFF9F1"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Texto",
      "default": "#17352B"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Acento",
      "default": "#A55334"
    }
  ],
  "presets": [
    {
      "name": "Bakatá - Categorías"
    }
  ]
}
{% endschema %}
